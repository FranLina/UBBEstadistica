<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="190dp"
    android:layout_marginStart="10dp"
    app:cardCornerRadius="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0.51">

            <ImageView
                android:id="@+id/btnEliminarEInvitado"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="140dp"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/papelera" />
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtItemPJEquipo"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_redondo_top"
                    android:paddingStart="43dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="PJ: 0"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtItemPGEquipo"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_redondo_bottom"
                    android:paddingStart="43dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="PG: 0"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/logoEquipoInvitado"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:background="@color/white"
                android:elevation="8dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/circular"
                app:srcCompat="@drawable/escudopredeterminado" />


        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            android:layout_weight="0.4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreEInvitado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="Nombre"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCategoriaEInvitado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Categoria"
                android:textAlignment="center"
                android:textColor="@android:color/darker_gray"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>